# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Used by docker-compose.yml (local development values - postgres/postgres is also what the tests expect) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=room_booking

# --- Used by the API / knex when started without Docker (npm start) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# In Docker Compose this value is overridden with the host "db" (see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/room_booking

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=15m
